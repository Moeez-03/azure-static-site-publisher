# Azure Service Principal & Subscription Credentials
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-azure-service-principal-client-secret
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Resource Provisioning Defaults
AZURE_RESOURCE_GROUP=rg-static-sites
AZURE_DEFAULT_LOCATION=eastus

# Flask Application Secret
SECRET_KEY=replace-with-a-random-secret-key-for-sessions
PORT=5000
